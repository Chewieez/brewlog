{
  "name": "brewlog-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "BrewLog - Multi-platform specialty coffee companion (Web, Mobile, WearOS)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@brewlog/web",
    "dev:mobile": "npm run start --workspace=@brewlog/mobile",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [
    "coffee",
    "specialty-coffee",
    "pourover",
    "espresso",
    "flair",
    "aeropress",
    "react",
    "react-native",
    "wearos"
  ],
  "author": "Greg Lawrence",
  "license": "MIT"
}