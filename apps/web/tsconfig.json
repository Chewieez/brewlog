{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@brewlog/core": ["../../packages/core/src/index.ts"],
      "@brewlog/core/*": ["../../packages/core/src/*"],
      "@brewlog/supabase": ["../../packages/supabase/src/index.ts"],
      "@brewlog/supabase/*": ["../../packages/supabase/src/*"],
      "@brewlog/ui": ["../../packages/ui/src/index.web.ts"],
      "@brewlog/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "src"
  ]
}
