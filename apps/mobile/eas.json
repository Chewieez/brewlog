{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development:simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "SENTRY_ORG": "brewlog",
        "SENTRY_PROJECT": "brewlog-mobile"
      }
    },
    "production": {
      "env": {
        "SENTRY_ORG": "brewlog",
        "SENTRY_PROJECT": "brewlog-mobile"
      }
    }
  }
}
