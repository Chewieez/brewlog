{
  "expo": {
    "name": "BrewLog",
    "slug": "brewlog",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "brewlog",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121214"
      }
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
